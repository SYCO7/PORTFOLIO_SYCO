# Canonical site URL
NEXT_PUBLIC_SITE_URL=https://cybersyco.vercel.app

# EmailJS client configuration (optional, used by frontend contact form)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# SMTP configuration for contact form email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password

# Optional Resend fallback (recommended for Vercel)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Portfolio Contact <onboarding@resend.dev>"

# Contact delivery settings
CONTACT_TO=tanmoymondaltanmoy94@gmail.com
CONTACT_FROM="Portfolio Contact <your-smtp-user@example.com>"

# Optional anti-spam controls for contact API
CONTACT_RATE_LIMIT_WINDOW_MS=600000
CONTACT_RATE_LIMIT_MAX=5
CONTACT_MIN_FILL_MS=2500
