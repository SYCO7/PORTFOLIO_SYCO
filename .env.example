# Canonical site URL
NEXT_PUBLIC_SITE_URL=https://cybersyco.vercel.app

# SMTP configuration for contact form email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password

# Contact delivery settings
CONTACT_TO=tanmoymondaltanmoy94@gmail.com
CONTACT_FROM="Portfolio Contact <your-smtp-user@example.com>"

# Optional anti-spam controls for contact API
CONTACT_RATE_LIMIT_WINDOW_MS=600000
CONTACT_RATE_LIMIT_MAX=5
CONTACT_MIN_FILL_MS=2500
